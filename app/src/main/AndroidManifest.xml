<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Privacy guarantee: this app has zero network access. Even if a library ever tries to add
        INTERNET through manifest merging, this line strips it, and CI fails if it appears.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!--
        Exact alarms fire timer and schedule edges on time even in Doze. USE_EXACT_ALARM (Android 13+)
        is auto-granted; Play restricts it, but this app is sideloaded. SCHEDULE_EXACT_ALARM covers
        Android 12/12L only. See AlarmScheduler.kt for the full reasoning.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Re-register the schedule alarm after a reboot (alarms don't survive one). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!--
        Package visibility (Android 11+): apps can only "see" other apps they declare here. We need it to
        open Messenger or a deep link as a block action. This grants no access to their data.
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.reddit.frontpage" />
    </queries>

    <application
        android:name=".InboxOnlyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.InboxOnly">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing the Quick Settings tile opens this activity. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- The Quick Settings tile. Only the system (holding BIND_QUICK_SETTINGS_TILE) can bind it. -->
        <service
            android:name=".service.FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_focus"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!--
            The blocker. Only the system can bind it (BIND_ACCESSIBILITY_SERVICE), and the user must
            switch it on under Settings > Accessibility. Its config XML limits it to four apps.
        -->
        <service
            android:name=".service.BlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Fired by AlarmManager at Focus edges. Not exported: only our own PendingIntent reaches it. -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="false" />

        <!--
            Re-registers alarms after boot, clock/time zone changes and app updates. Exported because the
            system sends these broadcasts; they're "protected", so other apps can't fake them.
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
