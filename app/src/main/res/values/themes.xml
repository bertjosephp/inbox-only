<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window theme only (what shows before Compose draws). The real UI theme is Material 3 in
        Compose. DeviceDefault.DayNight follows the system light/dark setting.
    -->
    <style name="Theme.InboxOnly" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
        The block screen fades and zooms instead of the usual slide, so it feels like a pause, not a jump.
        Older Android versions use these; newer ones need the explicit options the service passes.
    -->
    <style name="Theme.InboxOnly.BlockScreen">
        <item name="android:windowAnimationStyle">@style/BlockScreenAnimation</item>
    </style>

    <!-- It opens in its own task, so both the activity and task transitions need the fade. -->
    <style name="BlockScreenAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/block_screen_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/block_screen_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/block_screen_enter</item>
        <item name="android:taskCloseExitAnimation">@anim/block_screen_exit</item>
    </style>
</resources>
