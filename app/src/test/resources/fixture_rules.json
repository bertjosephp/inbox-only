{
  "version": 1,
  "placeholder": false,
  "comment": "TEST FIXTURE ONLY. Every identifier here is invented (fixture:...) to model screen types for unit tests. Never copy these into assets/rules.json.",
  "apps": [
    {
      "appId": "instagram",
      "package": "com.instagram.android",
      "allowed": [
        { "id": "dm_inbox", "match": { "allViewIds": ["fixture:id/inbox_list"] } },
        { "id": "dm_thread", "match": { "allViewIds": ["fixture:id/thread_composer"] } },
        { "id": "notifications", "match": { "allViewIds": ["fixture:id/activity_feed"] } }
      ],
      "reelViewer": {
        "match": { "allViewIds": ["fixture:id/reel_viewer"], "noneViewIds": ["fixture:id/bottom_nav"] },
        "surfaceId": "reels_tab",
        "openedFrom": ["dm_thread"],
        "identityViewId": "fixture:id/reel_author",
        "actions": [{ "type": "back" }]
      },
      "surfaces": [
        {
          "id": "reels_tab",
          "match": { "selectedViewIds": ["fixture:id/tab_reels"] },
          "actions": [{ "type": "redirect", "uri": "fixture://dm-inbox", "package": "com.instagram.android" }, { "type": "back" }]
        },
        {
          "id": "explore",
          "match": { "selectedViewIds": ["fixture:id/tab_search"], "noneViewIds": ["fixture:id/search_results"] },
          "actions": [{ "type": "redirect", "uri": "fixture://dm-inbox", "package": "com.instagram.android" }, { "type": "back" }]
        },
        {
          "id": "home_feed",
          "match": { "selectedViewIds": ["fixture:id/tab_home"] },
          "actions": [{ "type": "redirect", "uri": "fixture://dm-inbox", "package": "com.instagram.android" }, { "type": "back" }]
        }
      ]
    },
    {
      "appId": "facebook",
      "package": "com.facebook.katana",
      "allowed": [
        { "id": "notifications", "match": { "selectedContentDescriptions": ["fixture-desc Notifications"] } }
      ],
      "surfaces": [
        { "id": "reels", "match": { "allViewIds": ["fixture:id/fb_reels_viewer"] }, "actions": [{ "type": "back" }] },
        { "id": "video", "match": { "selectedContentDescriptions": ["fixture-desc Video"] }, "actions": [{ "type": "launch", "package": "com.facebook.orca" }] },
        { "id": "news_feed", "match": { "selectedContentDescriptions": ["fixture-desc Home"] }, "actions": [{ "type": "launch", "package": "com.facebook.orca" }] }
      ]
    },
    {
      "appId": "youtube",
      "package": "com.google.android.youtube",
      "allowed": [
        { "id": "watch", "match": { "allViewIds": ["fixture:id/watch_player"] } },
        { "id": "search", "match": { "allViewIds": ["fixture:id/search_box"] } },
        { "id": "subscriptions", "match": { "selectedContentDescriptions": ["fixture-desc Subscriptions"] } }
      ],
      "surfaces": [
        { "id": "shorts", "match": { "anyViewIds": ["fixture:id/shorts_player", "fixture:id/shorts_shelf_fullscreen"] }, "actions": [{ "type": "back" }] },
        { "id": "home_feed", "match": { "selectedContentDescriptions": ["fixture-desc Home"] }, "actions": [{ "type": "home" }] }
      ]
    },
    {
      "appId": "reddit",
      "package": "com.reddit.frontpage",
      "allowed": [
        { "id": "thread", "match": { "allViewIds": ["fixture:id/comments_list"] } }
      ],
      "surfaces": [
        { "id": "video_feed", "match": { "allViewIds": ["fixture:id/fullscreen_video_pager"] }, "actions": [{ "type": "home" }] },
        { "id": "search_results", "match": { "allViewIds": ["fixture:id/search_results_list"] }, "actions": [{ "type": "home" }] },
        { "id": "subreddit_feed", "match": { "allViewIds": ["fixture:id/subreddit_header"] }, "actions": [{ "type": "home" }] },
        { "id": "popular", "match": { "selectedContentDescriptions": ["fixture-desc Popular"] }, "actions": [{ "type": "home" }] },
        { "id": "home_feed", "match": { "selectedContentDescriptions": ["fixture-desc Home"] }, "actions": [{ "type": "home" }] }
      ]
    }
  ]
}
